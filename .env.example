# LegacyLock Configuration

# Mode: "local" (default, robust offline/standalone mode) or "supabase"
LEGACYLOCK_STORAGE_MODE="local"

# Port for backend + dev server
PORT=3000

# Session Secret for signed tokens / cookies
SESSION_SECRET="legacylock-prototype-secret-salt-key-2026"

# Optional: Supabase Credentials (if switching from local mode to real Supabase backend)
# Provide your Supabase project URL and keys to activate cloud sync:
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Optional AI Assistance (Server-side Gemini if enabled)
GEMINI_API_KEY=""

# AI Studio App URL
APP_URL="http://localhost:3000"
